# Host nginx vhost for Embu Premier Clinic (multi-app VPS).
# Proxies ${DOMAIN} -> Docker web on 127.0.0.1:${WEB_PORT}
#
# Install:
#   sudo ./host-ssl-setup.sh ${DOMAIN} admin@example.com

upstream embu_premier_web {
    server 127.0.0.1:${WEB_PORT};
}

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://embu_premier_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
